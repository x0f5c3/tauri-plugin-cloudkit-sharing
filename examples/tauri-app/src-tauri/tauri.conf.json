{
  "productName": "CloudKit Shared Notes",
  "version": "0.1.0",
  "identifier": "com.example.cloudkitsharing",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 850,
        "resizable": true,
        "title": "CloudKit Shared Notes",
        "width": 900
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "iOS": {
      "minimumSystemVersion": "15.0",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "cloudkit-sharing": {
      "containers": [
        "iCloud.com.example.cloudkitsharing"
      ],
      "assetDirectories": []
    }
  }
}
