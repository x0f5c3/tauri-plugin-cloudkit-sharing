{
  "name": "tauri-plugin-cloudkit-sharing-api",
  "version": "0.1.0",
  "description": "Native CloudKit sharing and shared record access for Tauri on iOS, iPadOS, and macOS",
  "type": "module",
  "types": "./dist-js/index.d.ts",
  "main": "./dist-js/index.cjs",
  "module": "./dist-js/index.js",
  "exports": {
    "types": "./dist-js/index.d.ts",
    "import": "./dist-js/index.js",
    "require": "./dist-js/index.cjs"
  },
  "files": [
    "dist-js",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-js.mjs",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "bindings": "cargo test --lib export_bindings -- --ignored",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/guest.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tslib": "^2.6.2"
  },
  "license": "MIT OR Apache-2.0"
}
